{
  "name": "harbor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Harbor account-representative workspace: client overview, meeting sessions, product projections, market scenarios, stress test and reports.",
  "repository": {
    "type": "git",
    "url": "https://git.example.com/harbor/harbor-frontend"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../backend/core/src/main/resources/openapi/harbor-api.yaml -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
