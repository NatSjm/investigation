{
  "_comment": "Layout of the backend repository as the generators see it. Paths are repo-relative, forward slashes. Every key is optional; these values are the defaults (the Harbor layout). Fill this file once per repository instead of editing the scripts; README.md in this folder explains every key.",
  "modules": [],
  "source_root": "src/main/kotlin",
  "test_root": "src/test/kotlin",
  "resources_root": "src/main/resources",
  "base_package": "com.acme.harbor",
  "layers": {
    "advice": "global exception handling (@RestControllerAdvice -> ProblemDetail)",
    "api": "REST controllers implementing the generated *Api interfaces (one per contract tag)",
    "api/error": "problem body factory (RFC 7807) and error models",
    "api/model": "hand-written API models (the contract models are generated)",
    "api/technical": "technical endpoints outside the contract (version, operations)",
    "api/validation": "request-level validation of API models",
    "client/rest": "wrappers over generated REST clients of external services (contracts in resources/api)",
    "client/kafka": "outbound Kafka producer used by the publishers in event/",
    "component": "infrastructure components (filters, parsers, template loaders)",
    "config": "Spring configuration",
    "context": "request / session context holders",
    "dao/model": "JPA entities (one per table)",
    "dao/repository": "Spring Data / JDBC repositories - tables per class in components.md",
    "dao/service": "persistence services over the repositories (lookups, filtered listings); no business rules",
    "dao/mapper": "row and entity mappers of the persistence layer",
    "dao/converter": "JPA attribute converters",
    "dao/specification": "JPA specifications (dynamic filters)",
    "databind": "Jackson serializers / deserializers",
    "enums": "enumerations",
    "event": "Kafka listeners and publishers (topics in events.md)",
    "exception": "exception types",
    "job": "scheduled jobs (triggers in jobs.md)",
    "manager": "orchestration per bounded context; transactional boundary; KDoc + @docs - READ FIRST",
    "mapper": "domain <-> API model mappers",
    "model": "domain models that are not entities (calculation inputs and results)",
    "service": "business services used by managers",
    "utils": "calculations (pure Kotlin, @docs <calculation>) and helpers",
    "validator": "business validation of requests and inputs"
  },
  "list_all_layers": ["api", "api/technical", "manager", "job", "event", "client/rest", "client/kafka", "utils", "validator", "component", "service", "dao/service"],
  "entry_layer": "manager",
  "calculation_layer": "utils",
  "graph_layers": ["api", "manager", "service", "dao", "event", "job", "client", "utils", "validator", "component"],
  "graph_exclude_layers": ["dao/model", "api/model"],
  "stereotypes": ["RestControllerAdvice", "RestController", "Service", "Component", "Configuration", "Repository", "Entity", "SpringBootApplication"],
  "repository_bases": ["JpaRepository", "CrudRepository", "PagingAndSortingRepository", "ListCrudRepository"],
  "test_pattern": "(Test|IT|Spec)\\.(kt|java)$",
  "exclude_paths": [],
  "rest": {
    "open_api": "harbor-core/src/main/resources/openapi/openapi_harbor.yaml",
    "handler_match": "operationId",
    "handler_pattern": "override\\s+fun\\s+(\\w+)\\s*\\(",
    "controller_annotation": "RestController",
    "session_header": "X-Harbor-Session",
    "session_marker": "SessionHeader"
  },
  "asyncapi": "harbor-core/src/main/resources/openapi/harbor-events.yaml",
  "external_contracts_dir": "harbor-core/src/main/resources/api",
  "db_docs": { "dir": "docs/db", "generate": true, "database": { "databaseType": "postgresql", "name": "harbor", "schema": "public" } },
  "kafka": {
    "listener_annotation": "KafkaListener",
    "producer_pattern": "\\.send\\(\\s*([^,)]+)",
    "property_files": ["harbor-core/src/main/resources/application.yml"],
    "schema_dirs": ["kafka-client/src/main/resources"]
  },
  "jobs": { "annotation": "Scheduled", "lock_annotation": "SchedulerLock" },
  "migrations": { "dir_pattern": "/db/migration/", "file_patterns": ["V*.sql", "R*.sql"], "view_patterns": ["*view*.sql"] },
  "parameters": {
    "enum_name": "ParameterKey",
    "table": "parameter_set",
    "key_column": "key",
    "value_column": "value",
    "scope_columns": ["scope_product_group", "scope_country", "scope_value"],
    "valid_from_column": "valid_from",
    "validator_layer": "validator"
  },
  "datasets": { "seed_dirs": ["scripts/db/seed"], "fixture_dirs": ["harbor-core/src/test/resources/datasets"] },
  "docs_tags_include": ["*.kt", "*.java"],
  "skip_generators": []
}
