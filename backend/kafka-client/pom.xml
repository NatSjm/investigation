<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.harbor</groupId>
    <artifactId>harbor-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>kafka-client</artifactId>
  <name>harbor-kafka-client</name>
  <description>
    Event contracts of the Harbor topics, no hand-written code: Avro schemas (src/main/resources/avro) of the events
    Harbor publishes and JSON schemas (src/main/resources/json_&lt;service&gt;) of the events consumed from external
    services. The payload classes are generated at build time into target/generated-sources (avro-maven-plugin ->
    com.acme.harbor.kafka.events, jsonschema2pojo -> com.acme.harbor.kafka.events.&lt;service&gt;) and never committed.
  </description>
  <properties>
    <avro.version>1.11.3</avro.version>
    <jsonschema2pojo.version>1.2.1</jsonschema2pojo.version>
  </properties>
  <dependencies>
    <dependency><groupId>org.apache.avro</groupId><artifactId>avro</artifactId><version>${avro.version}</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Avro: one .avsc per event Harbor publishes; generated Java classes use java.lang.String for strings -->
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>${avro.version}</version>
        <executions>
          <execution>
            <id>events-avro</id>
            <phase>generate-sources</phase>
            <goals><goal>schema</goal></goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/resources/avro</sourceDirectory>
              <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
              <stringType>String</stringType>
              <fieldVisibility>PRIVATE</fieldVisibility>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- JSON Schema: the events of the external services, one folder per service (json_<service>/) -->
      <plugin>
        <groupId>org.jsonschema2pojo</groupId>
        <artifactId>jsonschema2pojo-maven-plugin</artifactId>
        <version>${jsonschema2pojo.version}</version>
        <configuration>
          <outputDirectory>${project.build.directory}/generated-sources/jsonschema</outputDirectory>
          <annotationStyle>jackson2</annotationStyle>
          <includeConstructors>true</includeConstructors>
          <includeAdditionalProperties>false</includeAdditionalProperties>
          <includeGeneratedAnnotation>false</includeGeneratedAnnotation>
          <dateTimeType>java.time.Instant</dateTimeType>
          <useJakartaValidation>true</useJakartaValidation>
        </configuration>
        <executions>
          <execution>
            <id>events-market-data</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/resources/json_market-data</sourceDirectory>
              <targetPackage>com.acme.harbor.kafka.events.marketdata</targetPackage>
            </configuration>
          </execution>
          <execution>
            <id>events-document-service</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/resources/json_document-service</sourceDirectory>
              <targetPackage>com.acme.harbor.kafka.events.documentservice</targetPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
