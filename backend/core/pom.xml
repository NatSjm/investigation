<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.harbor</groupId>
    <artifactId>harbor-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>core</artifactId>
  <name>harbor-core</name>
  <description>The Harbor Spring Boot application: all business code, package-by-layer under src/main/kotlin/harbor/</description>

  <dependencies>
    <dependency><groupId>com.harbor</groupId><artifactId>kafka_client</artifactId></dependency>

    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>io.swagger.core.v3</groupId><artifactId>swagger-annotations</artifactId></dependency>

    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka-test</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        OpenAPI-first code generation. Generated sources land in target/generated-sources/openapi/<name>
        and are NOT committed; run "mvn -q -DskipTests generate-sources" before opening the project in an IDE.

        (1) harbor-api: server interfaces from src/main/resources/openapi/harbor-api.yaml, one interface per tag
            (harbor.api.generated.ClientsApi, MeetingsApi, Product1Api, Product2Api, CoverApi, MarketApi, StressApi,
            ReportsApi, AdminApi) carrying the request mappings, models in harbor.api.generated.model.
            The controllers in harbor.api implement them with plain "override fun <operationId>(...)".
        (2) one kotlin client per external contract in src/main/resources/api/*.yaml, package
            harbor.client.generated.<name>; wrapped by the thin @Component classes in harbor.client.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>harbor-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/harbor-api.yaml</inputSpec>
              <generatorName>kotlin-spring</generatorName>
              <output>${project.build.directory}/generated-sources/openapi/harbor-api</output>
              <apiPackage>harbor.api.generated</apiPackage>
              <modelPackage>harbor.api.generated.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <skipDefaultInterface>true</skipDefaultInterface>
                <documentationProvider>none</documentationProvider>
                <enumPropertyNaming>original</enumPropertyNaming>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>true</useBeanValidation>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>client-client-registry</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/api/client-registry.yaml</inputSpec>
              <generatorName>kotlin</generatorName>
              <library>jvm-spring-restclient</library>
              <output>${project.build.directory}/generated-sources/openapi/client-registry</output>
              <apiPackage>harbor.client.generated.clientregistry</apiPackage>
              <modelPackage>harbor.client.generated.clientregistry.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <serializationLibrary>jackson</serializationLibrary>
                <useSpringBoot3>true</useSpringBoot3>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>client-market-data</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/api/market-data.yaml</inputSpec>
              <generatorName>kotlin</generatorName>
              <library>jvm-spring-restclient</library>
              <output>${project.build.directory}/generated-sources/openapi/market-data</output>
              <apiPackage>harbor.client.generated.marketdata</apiPackage>
              <modelPackage>harbor.client.generated.marketdata.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <serializationLibrary>jackson</serializationLibrary>
                <useSpringBoot3>true</useSpringBoot3>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>client-cover-provider</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/api/cover-provider.yaml</inputSpec>
              <generatorName>kotlin</generatorName>
              <library>jvm-spring-restclient</library>
              <output>${project.build.directory}/generated-sources/openapi/cover-provider</output>
              <apiPackage>harbor.client.generated.coverprovider</apiPackage>
              <modelPackage>harbor.client.generated.coverprovider.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <serializationLibrary>jackson</serializationLibrary>
                <useSpringBoot3>true</useSpringBoot3>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>client-document-service</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/api/document-service.yaml</inputSpec>
              <generatorName>kotlin</generatorName>
              <library>jvm-spring-restclient</library>
              <output>${project.build.directory}/generated-sources/openapi/document-service</output>
              <apiPackage>harbor.client.generated.documentservice</apiPackage>
              <modelPackage>harbor.client.generated.documentservice.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <serializationLibrary>jackson</serializationLibrary>
                <useSpringBoot3>true</useSpringBoot3>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>client-file-exchange</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/api/file-exchange.yaml</inputSpec>
              <generatorName>kotlin</generatorName>
              <library>jvm-spring-restclient</library>
              <output>${project.build.directory}/generated-sources/openapi/file-exchange</output>
              <apiPackage>harbor.client.generated.fileexchange</apiPackage>
              <modelPackage>harbor.client.generated.fileexchange.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <serializationLibrary>jackson</serializationLibrary>
                <useSpringBoot3>true</useSpringBoot3>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <configuration>
          <sourceDirs>
            <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
            <sourceDir>${project.build.directory}/generated-sources/openapi/harbor-api/src/main/kotlin</sourceDir>
            <sourceDir>${project.build.directory}/generated-sources/openapi/client-registry/src/main/kotlin</sourceDir>
            <sourceDir>${project.build.directory}/generated-sources/openapi/market-data/src/main/kotlin</sourceDir>
            <sourceDir>${project.build.directory}/generated-sources/openapi/cover-provider/src/main/kotlin</sourceDir>
            <sourceDir>${project.build.directory}/generated-sources/openapi/document-service/src/main/kotlin</sourceDir>
            <sourceDir>${project.build.directory}/generated-sources/openapi/file-exchange/src/main/kotlin</sourceDir>
          </sourceDirs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>harbor.HarborApplicationKt</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
